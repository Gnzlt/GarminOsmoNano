# Used instead of monkey.jungle by scripts/build.sh --beta. The Store beta needs
# its own app id, so it builds from manifest-beta.xml, which the script writes
# from manifest.xml with the beta id swapped in. A jungle cannot reset
# project.manifest, so the rest of monkey.jungle is repeated here: keep in sync.
project.manifest = manifest-beta.xml

base.sourcePath = source;test
base.resourcePath = resources/main
base.excludeAnnotations = demo

